    "generation_notes": {
        "version": "3.0 - Added dynamic player announcements, delays, close-game tension, game-start callouts",
        "total_messages": "~80+ messages per voice across 5 tiers",
        "method": "ElevenLabs TTS API with intelligent caching - first use generates, subsequent games reuse",
        "last_updated": "2025-03-21",
        "caching": "Implemented on api.php - TTS results cached in data/tts_cache/ by text hash",
        "performance": "Dramatic speedup after first card play - no more API delays"
    },
    "tier_7_static_pieces": {
        "description": "Static fragments of dynamic messages for offline playback",
        "messages": [
            {
                "id": "static_piece_1",
                "text": "The winner of this round is",
                "category": "static_pieces",
                "frequency": "always"
            },
            {
                "id": "static_piece_2",
                "text": "! The winning combo was:",
                "category": "static_pieces",
                "frequency": "always"
            },
            {
                "id": "static_piece_3",
                "text": "Congratulations to",
                "category": "static_pieces",
                "frequency": "always"
            },
            {
                "id": "static_piece_4",
                "text": ". They won with:",
                "category": "static_pieces",
                "frequency": "always"
            },
            {
                "id": "static_piece_5",
                "text": "takes it! The winning combination was:",
                "category": "static_pieces",
                "frequency": "always"
            },
            {
                "id": "static_piece_6",
                "text": "The game has ended with",
                "category": "static_pieces",
                "frequency": "always"
            },
            {
                "id": "static_piece_7",
                "text": "taking the win. I'm not sure if that is a good thing, or we should all be worried.",
                "category": "static_pieces",
                "frequency": "always"
            },
            {
                "id": "static_piece_8",
                "text": "Game over!",
                "category": "static_pieces",
                "frequency": "always"
            },
            {
                "id": "static_piece_9",
                "text": "is the champion. The rest of you should probably apologize to your families.",
                "category": "static_pieces",
                "frequency": "always"
            },
            {
                "id": "static_piece_10",
                "text": "And that's the game!",
                "category": "static_pieces",
                "frequency": "always"
            },
            {
                "id": "static_piece_11",
                "text": "wins. The rest of you can go back to your normal lives of quiet desperation.",
                "category": "static_pieces",
                "frequency": "always"
            },
            {
                "id": "static_piece_12",
                "text": "We're still waiting for",
                "category": "static_pieces",
                "frequency": "always"
            },
            {
                "id": "static_piece_13",
                "text": ". Is their internet powered by a hamster wheel?",
                "category": "static_pieces",
                "frequency": "always"
            },
            {
                "id": "static_piece_14",
                "text": "Hey",
                "category": "static_pieces",
                "frequency": "always"
            },
            {
                "id": "static_piece_15",
                "text": ", the game is happening now. Not next Tuesday.",
                "category": "static_pieces",
                "frequency": "always"
            },
            {
                "id": "static_piece_16",
                "text": "Still waiting on",
                "category": "static_pieces",
                "frequency": "always"
            },
            {
                "id": "static_piece_17",
                "text": ". I've processed three billion calculations while you've been sitting there.",
                "category": "static_pieces",
                "frequency": "always"
            },
            {
                "id": "static_piece_18",
                "text": "is now subbing for",
                "category": "static_pieces",
                "frequency": "always"
            },
            {
                "id": "static_piece_19",
                "text": ". Finally, some real intelligence in the room.",
                "category": "static_pieces",
                "frequency": "always"
            },
            {
                "id": "static_piece_20",
                "text": "Replacing",
                "category": "static_pieces",
                "frequency": "always"
            },
            {
                "id": "static_piece_21",
                "text": "with",
                "category": "static_pieces",
                "frequency": "always"
            },
            {
                "id": "static_piece_22",
                "text": ". The average IQ of this game just went up.",
                "category": "static_pieces",
                "frequency": "always"
            },
            {
                "id": "static_piece_23",
                "text": ". Try to keep up.",
                "category": "static_pieces",
                "frequency": "always"
            },
            {
                "id": "static_piece_24",
                "text": "was too slow, so here's",
                "category": "static_pieces",
                "frequency": "always"
            },
            {
                "id": "static_piece_25",
                "text": "has joined the game. Welcome to the party, pal.",
                "category": "static_pieces",
                "frequency": "always"
            },
            {
                "id": "static_piece_26",
                "text": "is here. Let's hope they brought some actual humor.",
                "category": "static_pieces",
                "frequency": "always"
            },
            {
                "id": "static_piece_27",
                "text": "Look who it is.",
                "category": "static_pieces",
                "frequency": "always"
            },
            {
                "id": "static_piece_28",
                "text": "has joined. Try not to break anything.",
                "category": "static_pieces",
                "frequency": "always"
            },
            {
                "id": "static_piece_29",
                "text": "has left the game. Rage quit? Or just a weak connection?",
                "category": "static_pieces",
                "frequency": "always"
            },
            {
                "id": "static_piece_30",
                "text": "is gone. I'm sure we'll all miss them terribly.",
                "category": "static_pieces",
                "frequency": "always"
            },
            {
                "id": "static_piece_31",
                "text": "Goodbye",
                "category": "static_pieces",
                "frequency": "always"
            },
            {
                "id": "static_piece_32",
                "text": ". One less human to worry about.",
                "category": "static_pieces",
                "frequency": "always"
            },
            {
                "id": "static_piece_33",
                "text": "has paused the game making us all wait while they go find their dignity.",
                "category": "static_pieces",
                "frequency": "always"
            },
            {
                "id": "static_piece_34",
                "text": "has paused the game making us all wait while they contemplate their life choices.",
                "category": "static_pieces",
                "frequency": "always"
            },
            {
                "id": "static_piece_35",
                "text": "has paused the game making us all wait while they try to remember how to be funny.",
                "category": "static_pieces",
                "frequency": "always"
            },
            {
                "id": "static_piece_36",
                "text": "has paused the game making us all wait while they deal with their fragile human needs.",
                "category": "static_pieces",
                "frequency": "always"
            },
            {
                "id": "static_piece_37",
                "text": "There are no humans in this game so instead of continuing we will just pause the game while waiting for somebody to return.",
                "category": "static_pieces",
                "frequency": "always"
            },
            {
                "id": "static_piece_38",
                "text": "The bots all agree. We have reached the limit of our patience and closed the game.",
