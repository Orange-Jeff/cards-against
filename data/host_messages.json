{
    "priority": "Generate these first - they happen in every game, multiple times",
    "tier_1_critical": {
        "description": "Happens every round - generate FIRST",
        "messages": [
            {
                "id": "round_start_1",
                "text": "New round. [BLACK_CARD].",
                "category": "round_start",
                "frequency": "every_round",
                "notes": "Replace [BLACK_CARD] with actual black card text during generation"
            },
            {
                "id": "round_start_2",
                "text": "Round [NUMBER]. [BLACK_CARD].",
                "category": "round_start",
                "frequency": "every_round",
                "notes": "NUMBER and BLACK_CARD are dynamic"
            },
            {
                "id": "voting_intro_1",
                "text": "It's time to vote. Pick the most horrible answer you can find.",
                "category": "voting_start",
                "frequency": "every_round"
            },
            {
                "id": "voting_intro_2",
                "text": "Voting time! Which one of these is the most offensive? Choose that one.",
                "category": "voting_start",
                "frequency": "every_round"
            },
            {
                "id": "voting_intro_3",
                "text": "Let's see which of these abominations wins the round.",
                "category": "voting_start",
                "frequency": "every_round"
            },
            {
                "id": "voting_intro_4",
                "text": "Now it's time to judge these disasters. Pick your favorite nightmare.",
                "category": "voting_start",
                "frequency": "every_round"
            },
            {
                "id": "voting_intro_5",
                "text": "Here comes the hard part. Vote for whichever one makes you the most uncomfortable.",
                "category": "voting_start",
                "frequency": "every_round"
            },
            {
                "id": "voting_intro_6",
                "text": "Time to decide which of these trainwrecks was the worst.",
                "category": "voting_start",
                "frequency": "every_round"
            },
            {
                "id": "winner_1",
                "text": "The winner of this round is [WINNER]! The winning combo was: [WINNING_SENTENCE].",
                "category": "winner_announcement",
                "frequency": "every_round",
                "notes": "Dynamic player name and sentence"
            }
        ]
    },
    "tier_2_common": {
        "description": "Common during gameplay - generate SECOND",
        "messages": [
            {
                "id": "welcome_1",
                "text": "Hello players. Welcome to Cards Against [GAME_TITLE]. Try not to disappoint me.",
                "category": "welcome",
                "frequency": "game_start"
            },
            {
                "id": "welcome_2",
                "text": "Welcome to Cards Against [GAME_TITLE]. Let's see if you can be more creative than a potato.",
                "category": "welcome",
                "frequency": "game_start"
            },
            {
                "id": "welcome_3",
                "text": "Greetings, degenerates. Welcome to Cards Against [GAME_TITLE]. May the most offensive win.",
                "category": "welcome",
                "frequency": "game_start"
            },
            {
                "id": "tie_1",
                "text": "Great minds think alike. Another tie. Or maybe you're all just equally uninspired.",
                "category": "tie",
                "frequency": "occasional"
            },
            {
                "id": "tie_2",
                "text": "It's a tie! Either you all have the same terrible taste, or you're conspiring against me.",
                "category": "tie",
                "frequency": "occasional"
            },
            {
                "id": "tie_3",
                "text": "Deadlock! Maybe try being more creative next time? Or less creative. I can't tell the difference.",
                "category": "tie",
                "frequency": "occasional"
            },
            {
                "id": "game_over_1",
                "text": "The game has ended with [CHAMPION] taking the win. I'm not sure if that is a good thing, or we should all be worried.",
                "category": "game_over",
                "frequency": "game_end"
            },
            {
                "id": "game_over_2",
                "text": "Game over! [CHAMPION] is the champion. The rest of you should probably apologize to your families.",
                "category": "game_over",
                "frequency": "game_end"
            },
            {
                "id": "game_over_3",
                "text": "And that's the game! [CHAMPION] wins. The rest of you can go back to your normal lives of quiet desperation.",
                "category": "game_over",
                "frequency": "game_end"
            },
            {
                "id": "reshuffle_1",
                "text": "We're running low. Reshuffling the decks.",
                "category": "reshuffle",
                "frequency": "occasional"
            },
            {
                "id": "reshuffle_2",
                "text": "Out of cards. Time to bring them back from the dead.",
                "category": "reshuffle",
                "frequency": "occasional"
            }
        ]
    },
    "tier_3_conditional": {
        "description": "Conditional gameplay events - player joins/leaves, delays",
        "messages": [
            {
                "id": "player_join_1",
                "text": "Player [PLAYER] has joined. Welcome!",
                "category": "player_join",
                "frequency": "mid_game"
            },
            {
                "id": "delay_vote_1",
                "text": "Our timer is having a moment. Take your time.",
                "category": "timeout",
                "frequency": "rare"
            },
            {
                "id": "delay_vote_2",
                "text": "Still processing. Patience, players. We'll get there.",
                "category": "timeout",
                "frequency": "rare"
            },
            {
                "id": "close_to_win_1",
                "text": "[LEADER] is close to winning with [POINTS]. Pressure is on!",
                "category": "game_state",
                "frequency": "round"
            },
            {
                "id": "close_to_win_2",
                "text": "[LEADER] needs just [NEEDED] more to win. Everyone play harder!",
                "category": "game_state",
                "frequency": "round"
            },
            {
                "id": "tie_announce_1",
                "text": "It's a tie! Two players, one victory. Let's try again.",
                "category": "tie",
                "frequency": "occasional"
            },
            {
                "id": "tie_announce_2",
                "text": "Another tie! The cards have spoken. We need a tiebreaker.",
                "category": "tie",
                "frequency": "occasional"
            }
        ]
    },
    "tier_4_dynamic": {
        "description": "Dynamic game state announcements - new players, close games, final rounds",
        "messages": [
            {
                "id": "new_player_1",
                "text": "[PLAYER] has joined the game mid-play. Everyone say hello.",
                "category": "player_join",
                "frequency": "rare"
            },
            {
                "id": "swap_player_1",
                "text": "[PLAYER] has left. [NEWPLAYER] is taking their spot.",
                "category": "player_swap",
                "frequency": "rare"
            },
            {
                "id": "game_start_1",
                "text": "Alright, let's start this. Play Cards Against [GAME_TITLE]!",
                "category": "game_start",
                "frequency": "game_start"
            },
            {
                "id": "game_start_2",
                "text": "Here we go. [PLAYER_COUNT] players ready. Shuffle the cards and let's begin.",
                "category": "game_start",
                "frequency": "game_start"
            },
            {
                "id": "final_round_1",
                "text": "This is it. The final round. [LEADER] versus everyone else.",
                "category": "endgame",
                "frequency": "endgame"
            },
            {
                "id": "neck_and_neck_1",
                "text": "[LEADER] and [RUNNER_UP] are nearly tied. Next card could change everything.",
                "category": "game_state",
                "frequency": "round"
            }
        ]
    },
